# Copy to .env (git-ignored). It is loaded by the local server, `npm run db:migrate` and the
# CDK app (synth/deploy). Variables exported in the shell take precedence. All optional.

# HTTP port of the local server.
PORT=3000

# DynamoDB table serving the players. Unset: the bundled JSON dataset is used.
# PLAYERS_TABLE_NAME=tennis-players-local

# DynamoDB Local endpoint (docker compose up -d dynamodb). Unset: AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Secret expected in the x-api-key header of write requests (POST /players), 16+ characters.
# Unset: writes are refused with a 401. Also required by cdk synth/diff/deploy (not bootstrap).
# API_KEY=change-me-to-a-long-random-secret

# AWS region (when targeting a real table).
# AWS_REGION=eu-north-1
